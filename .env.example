# Yantra Environment Configuration
#
# Yantra itself needs no credentials or required environment variables -
# Claude CLI handles its own authentication, and Headroom (if installed)
# handles its own. This file is only useful if you want to inject custom
# environment variables into the launched Claude session via
# config/yantra.config.json's "environment" block.
#
# Copy this file to .env if you add variables here - Yantra does not load
# .env automatically today; set variables via your shell, or add them
# directly to config/yantra.config.json's "environment" block instead.

# Example: a custom variable made available inside the Claude session
# MY_CUSTOM_VAR=some_value

# ============================================================================
# OPTIONAL: Debug and Logging
# ============================================================================

# Enable debug logging (verbose output)
DEBUG=false

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ============================================================================
# SECURITY NOTES
# ============================================================================

# Never commit a real .env file with actual secrets.
# Add .env to .gitignore (already done in this repo).
